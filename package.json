{
  "name": "@adminforth/i18n-static",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adminforth-i18n-static": "dist/bin.js"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://adminforth.dev/docs/tutorial/Plugins/i18n-static/",
  "scripts": {
    "build": "tsc && rsync -av --exclude 'node_modules' custom dist/ && rsync -av skills dist/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devforth/adminforth-i18n-static.git"
  },
  "bugs": {
    "url": "https://github.com/devforth/adminforth-i18n-static/issues"
  },
  "keywords": [
    "adminforth",
    "i18n",
    "translation",
    "internationalization"
  ],
  "author": "DevForth (https://devforth.io)",
  "license": "MIT",
  "description": "Static translations plugin for AdminForth",
  "peerDependencies": {
    "adminforth": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "adminforth": "^4.0.0",
    "semantic-release": "^24.2.1",
    "semantic-release-slack-bot": "^4.0.2",
    "typescript": "^5.7.3"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "semantic-release-slack-bot",
        {
          "packageName": "@adminforth/i18n-static",
          "notifyOnSuccess": true,
          "notifyOnFail": true,
          "slackIcon": ":package:",
          "markdownReleaseNotes": true
        }
      ]
    ],
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ]
  },
  "dependencies": {
    "@adminforth/i18n": "^3.0.0",
    "tsx": "^4.23.15",
    "vue-i18n-extract": "^2.0.7"
  }
}
